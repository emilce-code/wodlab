// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model SystemCheck {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}

enum WeightUnit {
  KG
  LB
}

model User {
  id              String          @id @default(cuid())
  auth0UserId     String          @unique
  email           String          @unique
  athleteProfile  AthleteProfile?
  workoutsCreated Workout[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model AthleteProfile {
  id                              String                @id @default(cuid())
  userId                          String                @unique
  displayName                     String
  preferredWeightUnit             WeightUnit            @default(KG)
  preferredWorkoutLevelId         String?
  preferredWorkoutLevel           WorkoutLevel?         @relation("AthletePreferredWorkoutLevel", fields: [preferredWorkoutLevelId], references: [id])
  preferredPrescriptionCategoryId String?
  preferredPrescriptionCategory   PrescriptionCategory? @relation("AthletePreferredPrescriptionCategory", fields: [preferredPrescriptionCategoryId], references: [id])
  workoutResults                  WorkoutResult[]
  movementResults                 MovementResult[]
  user                            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                       DateTime              @default(now())
  updatedAt                       DateTime              @updatedAt
}

model MovementCategory {
  id          String     @id @default(cuid())
  key         String     @unique
  name        String
  description String?
  sortOrder   Int        @default(0)
  movements   Movement[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Movement {
  id               String                    @id @default(cuid())
  name             String                    @unique
  searchText       String                    @default("")
  categoryId       String
  category         MovementCategory          @relation(fields: [categoryId], references: [id])
  measurementTypes MovementMeasurementType[]
  workoutMovements WorkoutMovement[]
  movementResults  MovementResult[]
  isFoundational   Boolean                   @default(false)
  official         Boolean                   @default(true)
  baseMovementId   String?
  baseMovement     Movement?                 @relation("MovementVariants", fields: [baseMovementId], references: [id])
  variants         Movement[]                @relation("MovementVariants")
  aliases          String[]
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
}

model MeasurementType {
  id              String                    @id @default(cuid())
  key             String                    @unique
  name            String
  description     String?
  sortOrder       Int                       @default(0)
  movements       MovementMeasurementType[]
  movementResults MovementResult[]
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
}

model MovementMeasurementType {
  movementId        String
  measurementTypeId String
  movement          Movement        @relation(fields: [movementId], references: [id], onDelete: Cascade)
  measurementType   MeasurementType @relation(fields: [measurementTypeId], references: [id], onDelete: Cascade)

  @@id([movementId, measurementTypeId])
}

model MovementResult {
  id String @id @default(cuid())

  movementId String
  movement   Movement @relation(fields: [movementId], references: [id], onDelete: Cascade)

  athleteProfileId String
  athleteProfile   AthleteProfile @relation(fields: [athleteProfileId], references: [id], onDelete: Cascade)

  measurementTypeId String
  measurementType   MeasurementType @relation(fields: [measurementTypeId], references: [id])

  sourceWorkoutResultId String?
  sourceWorkoutResult   WorkoutResult? @relation("WorkoutResultGeneratedMovementResults", fields: [sourceWorkoutResultId], references: [id], onDelete: SetNull)

  performedAt DateTime

  reps            Int?
  load            Decimal?
  weightUnit      WeightUnit?
  distance        Int?
  durationSeconds Int?
  calories        Int?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([athleteProfileId, movementId, measurementTypeId, performedAt])
  @@index([sourceWorkoutResultId])
}

model WorkoutType {
  id                  String           @id @default(cuid())
  key                 String           @unique
  name                String
  description         String?
  sortOrder           Int              @default(0)
  defaultResultTypeId String?
  defaultResultType   ResultType?      @relation(fields: [defaultResultTypeId], references: [id])
  workouts            Workout[]
  sections            WorkoutSection[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

model ResultType {
  id           String          @id @default(cuid())
  key          String          @unique
  name         String
  description  String?
  sortOrder    Int             @default(0)
  workoutTypes WorkoutType[]
  results      WorkoutResult[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Workout {
  id              String           @id @default(cuid())
  name            String
  description     String?
  typeId          String
  type            WorkoutType      @relation(fields: [typeId], references: [id])
  createdByUserId String
  createdByUser   User             @relation(fields: [createdByUserId], references: [id])
  isBenchmark     Boolean          @default(false)
  isActive        Boolean          @default(true)
  deactivatedAt   DateTime?
  variants        WorkoutVariant[]
  results         WorkoutResult[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([isActive, createdAt])
}

model WorkoutSection {
  id              String            @id @default(cuid())
  variantId       String
  variant         WorkoutVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  typeId          String
  type            WorkoutType       @relation(fields: [typeId], references: [id])
  order           Int
  rounds          Int?
  durationSeconds Int?
  restSeconds     Int?
  notes           String?
  repScheme       Int[]
  movements       WorkoutMovement[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([variantId, order])
}

model WorkoutMovement {
  id              String         @id @default(cuid())
  sectionId       String
  section         WorkoutSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  movementId      String
  movement        Movement       @relation(fields: [movementId], references: [id])
  order           Int
  reps            Int?
  weight          Decimal?
  weightUnit      WeightUnit?
  distance        Int?
  calories        Int?
  durationSeconds Int?
  notes           String?

  prescriptions    WorkoutMovementPrescription[]
  performedResults WorkoutResultMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sectionId, order])
}

model WorkoutResult {
  id        String  @id @default(cuid())
  workoutId String
  workout   Workout @relation(fields: [workoutId], references: [id])

  workoutVariantId String
  workoutVariant   WorkoutVariant @relation(fields: [workoutVariantId], references: [id])

  prescriptionCategoryId String?
  prescriptionCategory   PrescriptionCategory? @relation(fields: [prescriptionCategoryId], references: [id])

  athleteProfileId String
  athleteProfile   AthleteProfile @relation(fields: [athleteProfileId], references: [id])

  resultTypeId String
  resultType   ResultType @relation(fields: [resultTypeId], references: [id])

  performedAt DateTime
  timeSeconds Int?
  rounds      Int?
  reps        Int?
  load        Decimal?
  weightUnit  WeightUnit?
  notes       String?

  performedMovements       WorkoutResultMovement[]
  generatedMovementResults MovementResult[]        @relation("WorkoutResultGeneratedMovementResults")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkoutResultMovement {
  id String @id @default(cuid())

  workoutResultId String
  workoutResult   WorkoutResult @relation(fields: [workoutResultId], references: [id], onDelete: Cascade)

  workoutMovementId String
  workoutMovement   WorkoutMovement @relation(fields: [workoutMovementId], references: [id], onDelete: Cascade)

  reps            Int?
  load            Decimal?
  weightUnit      WeightUnit?
  distance        Int?
  calories        Int?
  durationSeconds Int?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workoutResultId, workoutMovementId])
  @@index([workoutMovementId])
}

model WorkoutLevel {
  id                  String           @id @default(cuid())
  key                 String           @unique
  name                String
  description         String?
  sortOrder           Int              @default(0)
  variants            WorkoutVariant[]
  preferredByAthletes AthleteProfile[] @relation("AthletePreferredWorkoutLevel")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

model WorkoutVariant {
  id        String       @id @default(cuid())
  workoutId String
  workout   Workout      @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  levelId   String
  level     WorkoutLevel @relation(fields: [levelId], references: [id])
  name      String?
  notes     String?

  sections WorkoutSection[]
  results  WorkoutResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workoutId, levelId])
}

model PrescriptionCategory {
  id                  String                        @id @default(cuid())
  key                 String                        @unique
  name                String
  description         String?
  sortOrder           Int                           @default(0)
  prescriptions       WorkoutMovementPrescription[]
  results             WorkoutResult[]
  preferredByAthletes AthleteProfile[]              @relation("AthletePreferredPrescriptionCategory")
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
}

model WorkoutMovementPrescription {
  id                     String               @id @default(cuid())
  workoutMovementId      String
  workoutMovement        WorkoutMovement      @relation(fields: [workoutMovementId], references: [id], onDelete: Cascade)
  prescriptionCategoryId String
  prescriptionCategory   PrescriptionCategory @relation(fields: [prescriptionCategoryId], references: [id])

  reps            Int?
  weight          Decimal?
  weightUnit      WeightUnit?
  distance        Int?
  calories        Int?
  durationSeconds Int?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workoutMovementId, prescriptionCategoryId])
}
